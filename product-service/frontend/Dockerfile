FROM node:22-alpine AS build

# Backend URL

ARG VITE_AUTH_API_URL
ARG VITE_HOME_API_URL
ARG VITE_PRODUCT_API_URL
ARG VITE_CART_API_URL

# Frontend URL

ARG VITE_AUTH_FRONTEND_URL
ARG VITE_HOME_FRONTEND_URL
ARG VITE_PRODUCT_FRONTEND_URL
ARG VITE_CART_FRONTEND_URL                

# Backend ENV API's

ENV VITE_AUTH_API_URL=$VITE_AUTH_API_URL
ENV VITE_HOME_API_URL=$VITE_HOME_API_URL
ENV VITE_PRODUCT_API_URL=$VITE_PRODUCT_API_URL
ENV VITE_CART_API_URL=$VITE_CART_API_URL

# Frontend ENV API's

ENV VITE_AUTH_FRONTEND_URL=$VITE_AUTH_FRONTEND_URL
ENV VITE_HOME_FRONTEND_URL=$VITE_HOME_FRONTEND_URL
ENV VITE_PRODUCT_FRONTEND_URL=$VITE_PRODUCT_FRONTEND_URL
ENV VITE_CART_FRONTEND_URL=$VITE_CART_FRONTEND_URL              

WORKDIR /frontend-products
ADD . /frontend-products/
RUN npm install && npm run build

FROM nginx:alpine AS runtime
COPY --from=build /frontend-products/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80